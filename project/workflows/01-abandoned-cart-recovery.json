      "parameters": {
        "httpMethod": "POST",
        "path": "abandoned-cart",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh01",
      "name": "استقبال السلة المتروكة",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -860,
        300
      ],
      "webhookId": "abandoned-cart-hook"
    },
    {
      "parameters": {
        "jsCode": "// تطبيع حمولة الويبهوك من سلة أو زد إلى شكل موحّد\n// عدّل المسارات فقط إذا تغيّرت بنية الويبهوك لدى المنصة\nconst b = $input.first().json.body ?? $input.first().json;\n\n// --- سلة (Salla): حدث abandoned.cart ---\nconst salla = b?.data ?? {};\n// --- زد (Zid): بنية مختلفة قليلاً ---\nconst zid = b?.cart ?? {};\n\nconst src = Object.keys(salla).length ? 'salla' : (Object.keys(zid).length ? 'zid' : 'unknown');\nconst d = src === 'salla' ? salla : zid;\n\n// رقم الجوال: توحيد إلى صيغة دولية بلا + وبلا أصفار بادئة\nfunction normPhone(raw, cc) {\n  if (!raw) return '';\n  let p = String(raw).replace(/[^\\d]/g, '');\n  p = p.replace(/^00/, '');\n  if (p.startsWith('0')) p = (cc || '966') + p.slice(1);\n  if (p.length <= 10 && !p.startsWith(cc || '966')) p = (cc || '966') + p;\n  return p;\n}\n\nconst customer = d.customer ?? {};\nconst cc = String(customer.mobile_code ?? customer.country_code ?? '966').replace(/[^\\d]/g, '') || '966';\n\nconst items = d.items ?? d.products ?? [];\nconst total = Number(d.total?.amount ?? d.total ?? d.subtotal ?? 0);\n\nreturn [{\n  json: {\n    source: src,\n    cart_id: String(d.id ?? d.cart_id ?? d.token ?? ''),\n    customer_name: (customer.first_name ?? customer.name ?? 'عميلنا').toString().trim(),\n    phone: normPhone(customer.mobile ?? customer.phone, cc),\n    items_count: Array.isArray(items) ? items.length : 0,\n    first_item: (items[0]?.name ?? items[0]?.product?.name ?? 'منتج').toString(),\n    total: total,\n    currency: d.currency ?? 'SAR',\n    cart_url: d.checkout_url ?? d.url ?? d.cart_url ?? '',\n    store_name: '{{ $vars.STORE_NAME }}',\n    discount_code: '{{ $vars.DISCOUNT_CODE }}'\n  }\n}];\n"
      },
