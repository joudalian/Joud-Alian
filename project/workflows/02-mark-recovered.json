    {
      "parameters": {
        "jsCode": "// عند إنشاء أي طلب: نطبّع الجوال لنطابقه مع صف السلة المتروكة\nconst b = $input.first().json.body ?? $input.first().json;\nconst d = b?.data ?? b?.order ?? b;\nconst customer = d.customer ?? {};\n\nfunction normPhone(raw, cc) {\n  if (!raw) return '';\n  let p = String(raw).replace(/[^\\d]/g, '').replace(/^00/, '');\n  if (p.startsWith('0')) p = (cc || '966') + p.slice(1);\n  if (p.length <= 10 && !p.startsWith(cc || '966')) p = (cc || '966') + p;\n  return p;\n}\nconst cc = String(customer.mobile_code ?? customer.country_code ?? '966').replace(/[^\\d]/g, '') || '966';\n\nreturn [{ json: {\n  order_id: String(d.id ?? d.reference_id ?? ''),\n  phone: normPhone(customer.mobile ?? customer.phone, cc),\n  recovered_at: new Date().toISOString()\n}}];\n"
      },
      "id": "cd10",
      "name": "تطبيع الطلب",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
