{
  "name": "gethsemane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/size-product-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/size-product-images.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:links": "node scripts/ensure-build.mjs && playwright test tests/links.spec.ts --project=desktop",
    "assets": "node scripts/generate-assets.mjs",
    "test": "node scripts/ensure-build.mjs && playwright test",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run check:i18n && npm run check:claims && npm run check:contrast && node scripts/ensure-build.mjs --rebuild && npm run audit && playwright test",
    "check:claims": "node scripts/check-claims.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "catalog:import": "node scripts/import-products.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "intl-messageformat": "11.2.15",
    "typescript": "5.9.3"
  }
}
