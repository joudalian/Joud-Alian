# Every environment variable the site reads. Copy to .env.local for local development; set them in Vercel →
# Project → Settings → Environment Variables for deployments. Never commit real values (.env* files are ignored).

# --- Site ---
# Absolute origin of the deployed site: canonical URLs, hreflang, the sitemap, email links, auth callbacks.
SITE_URL=

# --- Database (accounts, orders, coupons) ---
# Postgres connection string (e.g. Neon from the Vercel Marketplace; use the pooled URL).
# Leave empty locally: development and tests use PGlite, an embedded database in .data/pglite.
DATABASE_URL=
# Optional: where PGlite keeps its files when DATABASE_URL is empty (default .data/pglite).
PGLITE_DIR=

# --- Accounts (Better Auth) ---
# Random secret of at least 32 characters, e.g. `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=
# Comma-separated email addresses that may open /admin (their accounts must be verified).
ADMIN_EMAILS=

# --- Payments (Stripe Checkout) ---
# sk_test_… for test mode, sk_live_… for real payments. Empty = checkout shows "Payments are opening soon".
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
# API key from resend.com and a verified sender, e.g. "Gethsemane <orders@your-domain>".
# Without them emails are not sent (development prints them to the console).
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional features (defaults in src/config/store.ts → FEATURES) ---
# Comma-separated overrides: a name turns a feature on, "-name" turns it off, e.g. "reviews,newsletter,-christmas".
# Names: wallets, freeShippingBar, dutiesNote, bulkOrders, engravingPreview, completeTheSet, reviews, wishlistSync,
# newsletter, shopSearch, christmas, careCard.
FEATURES=
# Optional overrides of store settings (otherwise the values in src/config/store.ts are used):
# items total in USD from which standard shipping is free (needs freeShippingBar); empty = no free shipping.
FREE_SHIPPING_THRESHOLD_USD=
# last day to order for Christmas delivery, YYYY-MM-DD (shown on /christmas); empty = not shown.
CHRISTMAS_ORDER_BY_DATE=
# percent off for the newsletter welcome code (needs newsletter); 0 or empty = no code.
NEWSLETTER_WELCOME_PERCENT=
